    "client": ["com.cactustopme.coolmessenger.CoolMessengerMod"]
  },
  "mixins": ["coolmessenger.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
